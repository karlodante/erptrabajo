# ============================================================
# TiendaMama Lácteos - Variables de Entorno
# Copia este archivo a .env y ajusta los valores según tu entorno
# ============================================================

# ------------------------------------------------------------
# FastAPI / Backend
# ------------------------------------------------------------
APP_NAME=Tiendamama Lácteos — Backend
APP_VERSION=0.1.0
DEBUG=True
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tiendamama
DB_USER=postgres
DB_PASSWORD=postgres
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------
JWT_SECRET=cambiar-esta-clave-en-produccion!!123
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ------------------------------------------------------------
# Umbrales de Negocio
# ------------------------------------------------------------
ALERTA_VENCIMIENTO_DIAS=5
ALERTA_STOCK_UMBRAL=5
ALERTAS_CRON_SEGUNDOS=600

# Dolibarr ERP (API REST) — sin prefijo APP_
DOLIBARR_URL=http://localhost/dolibarr/api/index.php
DOLIBARR_API_KEY=poner-aqui-la-api-key-de-dolibarr
DOLIBARR_SOCID_DEFAULT=1
DOLIBARR_WAREHOUSE_ID=1
DOLIBARR_RETRY_SECONDS=300
DOLIBARR_TIMEOUT=10
DOLIBARR_VALIDAR_FACTURA=true
DOLIBARR_TVA_TX_DEFAULT=0
# Lote inicial con el stock de Dolibarr para productos sin lotes locales
DOLIBARR_LOTE_INICIAL=true
DOLIBARR_LOTE_DIAS_VENCIMIENTO=30
