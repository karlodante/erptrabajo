# App / FastAPI
APP_APP_NAME=Tiendamama Lácteos - Backend
APP_APP_VERSION=0.1.0
APP_DEBUG=true
APP_API_V1_PREFIX=/api/v1

# CORS (frontend local + Electron file://)
APP_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","http://localhost:8080","file://"]

# PostgreSQL
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_NAME=tiendamama
APP_DB_USER=postgres
APP_DB_PASSWORD=postgres
APP_DB_ECHO=false
APP_DB_POOL_SIZE=10
APP_DB_MAX_OVERFLOW=20

# JWT (⚠ CAMBIAR LA CLAVE en PRODUCCIÓN)
APP_JWT_SECRET=PONER-UNA-CLAVE-SUPER-SEGURA-32B-EN-PROD!!!
APP_JWT_ALGORITHM=HS256
APP_JWT_EXPIRE_MINUTES=720

# Umbrales lógicos
APP_ALERTA_VENCIMIENTO_DIAS=5
APP_ALERTA_STOCK_UMBRAL=5
APP_ALERTAS_CRON_SEGUNDOS=600
