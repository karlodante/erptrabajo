{
  "name": "tiendamama-desktop",
  "version": "0.1.0",
  "description": "TiendaMama Lácteos — Aplicación de escritorio (FastAPI + Vue 3). Instalador .exe Windows NSIS.",
  "private": true,
  "author": "TiendaMama <soporte@tiendamama.ar>",
  "license": "UNLICENSED",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev:all": "concurrently -k -n \"FRONT,BACK,ELECT\" -c \"bgCyan.black,bgMagenta.black,bgGreen.black\" \"npm:dev:front\" \"npm:dev:back\" \"timeout /t 6 /nobreak > nul && npm run dev\"",
    "dev:front": "cd ../frontend && npm run dev",
    "dev:back":  "cd ../backend && ..\\.venv\\Scripts\\uvicorn.exe app.main:app --host=127.0.0.1 --port=8765 --reload",
    "pack": "electron-builder --dir --win",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-serve": "^1.3.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ar.com.tiendamama.desktop",
    "productName": "TiendaMama Lacteos",
    "asar": true,
    "asarUnpack": [
      "assets/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "app/frontend"
      },
      {
        "from": "python-dist",
        "to": "app/python-dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "TiendaMama-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TiendaMama Lácteos",
      "uninstallDisplayName": "Desinstalar TiendaMama",
      "license": "EULA.txt",
      "include": "installer.nsh"
    },
    "portable": {
      "artifactName": "TiendaMama-Portable-${version}-${arch}.${ext}"
    },
    "compression": "maximum"
  }
}
